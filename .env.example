# ==============================================================================
# PathSnap Environment Configuration Template
# Copy this file to `.env` and adjust values for your local machine.
# Never commit `.env` or sensitive credentials to Git.
# ==============================================================================

# --- Runtime & Logging ---
APP_ENV=development
LOG_LEVEL=INFO
RANDOM_SEED=42

# --- Dataset Partition Paths (80 / 10 / 10 Split) ---
DATA_TRAIN_DIR=data/train
DATA_STUDENT_TEST_DIR=data/student_test
DATA_EVALUATOR_TEST_DIR=data/evaluator_test
DATA_PROCESSED_DIR=data/processed

# --- Model & Config Artifact Paths ---
CONFIG_PATH=configs/default_config.yaml
MODEL_ARTIFACT_PATH=artifacts/models/best_model.joblib
PREPROCESSOR_ARTIFACT_PATH=artifacts/models/preprocessor.joblib
RESULTS_DIR=results

# --- Laptop 1: FastAPI Inference & Evaluation Server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Laptop 2: Evaluator UI Client ---
# On Laptop 2, replace localhost with Laptop 1's LAN IP (e.g., http://192.168.1.10:8000)
API_BASE_URL=http://localhost:8000
API_TIMEOUT_SECONDS=30
UI_HOST=0.0.0.0
UI_PORT=8501
